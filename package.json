{
  "name": "inv-ledger",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:concurrency": "jest --config jest-integration.json",
    "migration:up": "node-pg-migrate -m migrations --database env:DATABASE_URL up",
    "migration:down": "node-pg-migrate -m migrations --database env:DATABASE_URL down"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28"
  }
}
