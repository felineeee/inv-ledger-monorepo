{
  "name": "inv-ledger-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "db:migrate": "tsx src/db/migrate_raw.ts",
    "db:generate": "kysely-codegen --out-file src/db/types.ts --dialect=postgres",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "docker compose down -v && docker compose up -d && sleep 2 && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@inv-ledger/configs": "workspace:*",
    "@inv-ledger/databases": "workspace:*",
    "@inv-ledger/decorators": "workspace:*",
    "@inv-ledger/filters": "workspace:*",
    "@inv-ledger/guards": "workspace:*",
    "@inv-ledger/interceptors": "workspace:*",
    "@inv-ledger/loggers": "workspace:*",
    "@inv-ledger/caches": "workspace:*",
    "@nestjs/config": "^4.0.4",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@types/pg": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.3.1",
    "kysely": "0.29.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@inv-ledger/tsconfig": "workspace:*",
    "@types/redlock": "^4.0.8",
    "kysely-codegen": "^0.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
